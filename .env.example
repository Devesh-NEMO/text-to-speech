# ─────────────────────────────────────────────────────────────
# VaaniTTS configuration
# Copy this file to `.env` and fill in ONE of the engines below.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Option A · Azure AI Speech  (recommended: 500,000 free chars/month)
# Create a "Speech" resource: https://portal.azure.com → AI services → Speech
# Keys + region are on the resource's "Keys and Endpoint" page.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Option B · Sarvam AI  (excellent Indian voices, ₹100 free credits on signup)
# https://dashboard.sarvam.ai → API keys
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v4-flash

# Optional
# TTS_PROVIDER=azure          # force a provider: azure | sarvam | mock
# MAX_CHARS=50000             # hard limit on pasted text
# CHUNK_CHARS=1800            # characters per API call (max 1800)
# PORT=8000
# TTS_MOCK=1                  # test the app without any API key (silent audio)
# NO_BROWSER=1                # don't auto-open the browser on start
